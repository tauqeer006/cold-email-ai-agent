APP_NAME="Cold Email Automation"
LOG_LEVEL=INFO
HUNTER_API_KEY=""
HUNTER_MAX_RETRIES=3
HUNTER_RETRY_BASE_DELAY=2
HUNTER_REQUEST_TIMEOUT=30
BATCH_SIZE=10
