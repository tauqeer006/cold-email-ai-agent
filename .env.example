OLLAMA_CHAT_MAX_TOKENS=96
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=""
MAIL_FROM_NAME="Your Name"
